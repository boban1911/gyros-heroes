{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "vite --port $PORT",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/loyalty/verify", "destination": "/api/auth/verify" },
    { "source": "/scan", "destination": "/scan/index.html" },
    { "source": "/scan/login", "destination": "/scan/index.html" }
  ]
}
